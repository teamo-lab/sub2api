# =============================================================================
# Sub2API Deploy Directory - Git Ignore
# =============================================================================

# Data directories (generated at runtime when using docker-compose.local.yml)
data/
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env
rollout/runtime.env
rollout/runtime/
rollout/data-blue/
rollout/data-green/
rollout/data-worker/
rollout/state.json
rollout/history.jsonl
rollout/controller.lock
reports/

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log
