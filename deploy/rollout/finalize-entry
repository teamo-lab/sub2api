#!/usr/bin/env bash
set -euo pipefail

root="${SUB2API_DEPLOY_ROOT:-/opt/sub2api/deploy}"
controller="$root/bin/sub2api-rollout"
entry_switch="$root/bin/sub2api-entry-switch"
state_path="$root/rollout/state.json"
runtime="$root/rollout/runtime"
legacy="${SUB2API_LEGACY_CONTAINER:-sub2api}"
operator_ip="${SUB2API_ROLLOUT_OPERATOR_IP:-}"
public_port="${SUB2API_PUBLIC_PORT:-8080}"
compose=(docker compose -p sub2api-rollout -f "$root/docker-compose.bluegreen.yml")

fail() {
  printf '{"ok":false,"error_code":"%s","message":"%s"}\n' "$1" "$2"
  exit "${3:-4}"
}

[[ -x "$controller" && -x "$entry_switch" && -f "$state_path" ]] || fail rollout_not_installed 'rollout controller or state is unavailable'
[[ -z "$operator_ip" || "$operator_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || fail invalid_operator_ip 'operator IP must be IPv4' 2

status="$($controller status --json)"
[[ "$(jq -r '.phase' <<<"$status")" == complete ]] || fail release_not_complete 'release must be complete before final entry transfer'
stable="$(jq -r '.stable_slot' <<<"$status")"
active="$(jq -r '.active_slot' <<<"$status")"
candidate="$(jq -r '.candidate_slot' <<<"$status")"
[[ "$stable" =~ ^(blue|green)$ && "$active" == "$stable" && "$candidate" =~ ^(blue|green)$ && "$candidate" != "$stable" ]] \
  || fail stable_slot_invalid 'final entry transfer requires one completed stable slot and one idle candidate'
[[ "$(jq -r --arg slot "$stable" '.[$slot].health' <<<"$status")" == healthy && "$(jq -r --arg slot "$stable" '.[$slot].weight' <<<"$status")" == 100 ]] \
  || fail stable_slot_not_ready 'stable slot must be healthy at weight 100'
[[ "$(jq -r --arg slot "$candidate" '.[$slot].health' <<<"$status")" == healthy && "$(jq -r --arg slot "$candidate" '.[$slot].weight' <<<"$status")" == 0 ]] \
  || fail candidate_slot_not_idle 'candidate slot must be healthy at weight 0'
[[ "$(docker inspect --format '{{.State.Health.Status}}' "$legacy" 2>/dev/null || true)" == healthy ]] || fail legacy_unhealthy 'legacy singleton fallback is not healthy'
"$entry_switch" status | jq -e '.haproxy_entry_active == true and .haproxy_healthy == true' >/dev/null || fail temporary_entry_inactive 'temporary HAProxy redirect is not active'

generation="$(jq -r '.generation' "$state_path")"
exec 9>"$root/rollout/controller.lock"
flock -n 9 || fail controller_locked 'another rollout action holds the controller lock' 5
[[ "$(jq -r '.generation' "$state_path")" == "$generation" ]] || fail state_changed 'rollout state changed during entry precheck'

count_legacy_connections() {
  local port_hex
  port_hex="$(printf '%04X' "$public_port")"
  docker exec "$legacy" sh -c "awk -v suffix=\":$port_hex\$\" '\$2 ~ suffix && \$4 == \"01\" {count++} END {print count+0}' /proc/net/tcp /proc/net/tcp6" 2>/dev/null || printf '%s\n' 999
}

for check in 1 2 3; do
  [[ "$(count_legacy_connections)" == 0 ]] || fail legacy_connections_active 'legacy still has established public-port connections'
  sleep 2
done

env_value() {
  local container="$1" key="$2"
  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container" | awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}'
}

blue_image="$(docker inspect --format '{{.Image}}' sub2api-blue)"
green_image="$(docker inspect --format '{{.Image}}' sub2api-green)"
blue_release="$(env_value sub2api-blue SUB2API_RELEASE_ID)"
green_release="$(env_value sub2api-green SUB2API_RELEASE_ID)"
blue_version="$(env_value sub2api-blue SUB2API_DEPLOYMENT_VERSION)"
green_version="$(env_value sub2api-green SUB2API_DEPLOYMENT_VERSION)"
[[ "$blue_image" =~ ^sha256:[0-9a-f]{64}$ && "$green_image" =~ ^sha256:[0-9a-f]{64}$ ]] || fail image_identity_invalid 'slot image identity is invalid'

worker_started=false
final_started=false
socket_switched=false
state_backup="$runtime/state.entry-before.json"

recover_on_error() {
  local rc=$?
  trap - ERR
  # restore-proxy is idempotent. Always attempt it because finalize may have
  # removed one redirect rule before a later command failed.
  "$entry_switch" restore-proxy >/dev/null 2>&1 || true
  if $socket_switched; then
    rm -f -- "$runtime/admin.sock"
    if [[ -S "$runtime/admin-bootstrap.sock" ]]; then mv -f -- "$runtime/admin-bootstrap.sock" "$runtime/admin.sock"; fi
  fi
  if [[ -s "$state_backup" ]]; then install -o root -g root -m 0600 "$state_backup" "$state_path"; fi
  if $final_started; then docker stop --time 30 sub2api-haproxy-final >/dev/null 2>&1 || true; fi
  if $worker_started; then docker stop --time 60 sub2api-worker >/dev/null 2>&1 || true; fi
  # docker stop can terminate the container before returning a non-zero client
  # status, so recovery checks container existence instead of a shell flag.
  if docker inspect "$legacy" >/dev/null 2>&1; then docker start "$legacy" >/dev/null 2>&1 || true; fi
  printf '{"ok":false,"error_code":"entry_transfer_failed_safe","message":"Entry transfer failed; temporary proxy and legacy fallback restoration were attempted."}\n'
  exit "$rc"
}
trap recover_on_error ERR

install -o root -g root -m 0600 "$state_path" "$state_backup"
docker stop --time 900 "$legacy" >/dev/null

common_env=(
  SUB2API_BLUE_IMAGE="$blue_image" SUB2API_BLUE_RELEASE_ID="$blue_release" SUB2API_BLUE_VERSION="$blue_version" SUB2API_BLUE_DIGEST="$blue_image"
  SUB2API_GREEN_IMAGE="$green_image" SUB2API_GREEN_RELEASE_ID="$green_release" SUB2API_GREEN_VERSION="$green_version" SUB2API_GREEN_DIGEST="$green_image"
  SUB2API_WORKER_IMAGE="$(docker inspect --format '{{.Image}}' "sub2api-$stable")" SUB2API_WORKER_RELEASE_ID="$(env_value "sub2api-$stable" SUB2API_RELEASE_ID)" SUB2API_WORKER_VERSION="$(env_value "sub2api-$stable" SUB2API_DEPLOYMENT_VERSION)" SUB2API_WORKER_DIGEST="$(docker inspect --format '{{.Image}}' "sub2api-$stable")"
	ROLLOUT_FINAL_ENTRY_PORT="$public_port"
)

env "${common_env[@]}" "${compose[@]}" --profile worker up -d --no-deps --no-build --force-recreate sub2api-worker >/dev/null
worker_started=true
for attempt in $(seq 1 60); do
  worker_health="$(docker inspect --format '{{.State.Health.Status}}' sub2api-worker 2>/dev/null || true)"
  [[ "$worker_health" == healthy ]] && break
  sleep 2
done
[[ "${worker_health:-}" == healthy && "$(docker inspect --format '{{.RestartCount}}' sub2api-worker)" == 0 ]]

# Export the current blue=100/green=0 runtime state before starting the final
# proxy. It will load this file on every future restart instead of reverting to
# static config weights.
"$controller" persist-runtime-state --json >/dev/null
[[ -s "$runtime/server-state" && "$(stat -c '%a' "$runtime/server-state")" == 600 ]]

env "${common_env[@]}" "${compose[@]}" --profile final-entry up -d --no-deps --no-build --force-recreate haproxy-final >/dev/null
final_started=true
for attempt in $(seq 1 60); do
  final_health="$(docker inspect --format '{{.State.Health.Status}}' sub2api-haproxy-final 2>/dev/null || true)"
  [[ "$final_health" == healthy ]] && break
  sleep 2
done
[[ "${final_health:-}" == healthy && "$(docker inspect --format '{{.RestartCount}}' sub2api-haproxy-final)" == 0 ]]
[[ "$(curl -fsS -D - -o /dev/null --max-time 5 "http://127.0.0.1:$public_port/health" | awk -F': ' 'tolower($1)=="x-sub2api-deployment-slot" {gsub("\\r", "", $2); print $2}')" == "$stable" ]]
[[ -S "$runtime/admin.sock" && -S "$runtime/admin-final.sock" && ! -e "$runtime/admin-bootstrap.sock" ]]
mv -- "$runtime/admin.sock" "$runtime/admin-bootstrap.sock"
ln -s admin-final.sock "$runtime/admin.sock"
socket_switched=true

python3 - "$state_path" "$generation" "$public_port" <<'PY'
import datetime as dt, json, os, pathlib, sys, tempfile
path = pathlib.Path(sys.argv[1]); expected = int(sys.argv[2]); public_port = int(sys.argv[3])
state = json.loads(path.read_text(encoding="utf-8"))
if state.get("generation") != expected:
    raise SystemExit("generation changed")
state["entry_port"] = public_port
state["entry_mode"] = "direct"
state["entry_proxy_container"] = "sub2api-haproxy-final"
state["generation"] = expected + 1
state["updated_at"] = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
payload = json.dumps(state, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n"
fd, temporary = tempfile.mkstemp(prefix=".state.entry.", dir=str(path.parent), text=True)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(payload); handle.flush(); os.fsync(handle.fileno())
    os.replace(temporary, path)
    directory_fd = os.open(path.parent, os.O_RDONLY)
    try: os.fsync(directory_fd)
    finally: os.close(directory_fd)
finally:
    try: os.unlink(temporary)
    except FileNotFoundError: pass
PY

"$entry_switch" finalize "$operator_ip" >/dev/null
[[ "$(curl -fsS -D - -o /dev/null --max-time 5 "http://127.0.0.1:$public_port/health" | awk -F': ' 'tolower($1)=="x-sub2api-deployment-slot" {gsub("\\r", "", $2); print $2}')" == "$stable" ]]

python3 - "$root/rollout/history.jsonl" "$generation" "$public_port" "$stable" <<'PY'
import datetime as dt, json, os, pathlib, sys
path = pathlib.Path(sys.argv[1])
public_port = int(sys.argv[3]); stable = sys.argv[4]
event = {
    "at": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    "action": "finalize_entry",
    "before": {"entry_port": 18080, "generation": int(sys.argv[2])},
    "after": {"entry_port": public_port, "entry_mode": "direct", "generation": int(sys.argv[2]) + 1},
    "stable_slot": stable,
    "legacy_preserved_stopped": True,
    "temporary_proxy_preserved": True,
}
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
with os.fdopen(fd, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(event, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n")
    handle.flush()
    os.fsync(handle.fileno())
PY

trap - ERR
printf '{"ok":true,"entry_port":%s,"stable_slot":"%s","worker_healthy":true,"legacy_preserved_stopped":true,"temporary_proxy_preserved":true}\n' "$public_port" "$stable"
